# Port the API server listens on. Render sets this automatically in production.
PORT=4000

# Path to the SQLite database file. Defaults to backend/data/taskflow.db if unset.
# On Render, point this at a path inside a mounted persistent disk so data
# survives restarts/deploys, e.g. /var/data/taskflow.db
DB_PATH=./data/taskflow.db
